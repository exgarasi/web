{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "exgarasi",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-18",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "upload_source_maps": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "2dd24d3626a04be0a66a138b4e8bfdb3",
      "remote": true
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "EMAIL_FROM": "EXGARASI <noreply@exgarasi.id>",
    "R2_PUBLIC_BASE_URL": "https://media.exgarasi.id"
  },
  "previews": {
    "vars": {
      "EMAIL_FROM": "EXGARASI Preview <noreply@exgarasi.id>",
      "R2_PUBLIC_BASE_URL": "https://media-preview.exgarasi.id",
      "APP_BASE_URL": "https://integration-preview-marketplace-exgarasi.exgarasi-id.workers.dev",
      "NEXT_PUBLIC_APP_URL": "https://integration-preview-marketplace-exgarasi.exgarasi-id.workers.dev"
    },
    "hyperdrive": [
      {
        "binding": "HYPERDRIVE",
        "id": "2dd24d3626a04be0a66a138b4e8bfdb3",
        "remote": true
      }
    ],
    "r2_buckets": [
      {
        "binding": "EXGARASI_MEDIA",
        "bucket_name": "exgarasi-preview-media"
      }
    ]
  }
}
