# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000

# Runtime PostgreSQL connection: non-owner role, NOSUPERUSER, NOBYPASSRLS
DATABASE_URL=postgresql://exgarasi_app:replace-me@localhost:5432/exgarasi

# Schema migration connection: owner/admin role, used only by npm run db:migrate
MIGRATION_DATABASE_URL=postgresql://exgarasi_migrator:replace-me@localhost:5432/exgarasi

# Authentication
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters

# Email verification (required in production)
RESEND_API_KEY=
EMAIL_FROM=EXGARASI <noreply@your-verified-domain.com>

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=exgarasi-media
R2_PUBLIC_BASE_URL=

# Payment provider
PAYMENT_PROVIDER=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# Shipping
SHIPPING_PROVIDER=
SHIPPING_API_KEY=

# Observability
SENTRY_DSN=
