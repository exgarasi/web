# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000

# Supabase PostgreSQL: server-side only; never prefix these with NEXT_PUBLIC_
# Runtime: exgarasi_app, NOSUPERUSER, NOBYPASSRLS, non-owner
DATABASE_URL=postgresql://exgarasi_app:REPLACE_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require
# Migration only: exgarasi_migrator, direct/session-pooler connection
MIGRATION_DATABASE_URL=postgresql://exgarasi_migrator:REPLACE_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# Authentication
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters

# Email verification (required in production)
RESEND_API_KEY=
EMAIL_FROM=EXGARASI <noreply@your-verified-domain.com>

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=exgarasi-media
R2_PUBLIC_BASE_URL=

# Payment provider
PAYMENT_PROVIDER=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# Shipping
SHIPPING_PROVIDER=
SHIPPING_API_KEY=

# Observability
SENTRY_DSN=
