# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000

# Database - use a managed PostgreSQL provider in preview/production
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/exgarasi

# Authentication - generate a strong random secret; never commit real values
AUTH_SECRET=replace-with-a-long-random-secret

# Object storage (Cloudflare R2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=exgarasi-media
R2_PUBLIC_BASE_URL=

# Payment provider (sandbox credentials only in local development)
PAYMENT_PROVIDER=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# Shipping provider
SHIPPING_PROVIDER=
SHIPPING_API_KEY=

# Email
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=

# Observability
SENTRY_DSN=
