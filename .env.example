# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000

# Runtime PostgreSQL is provided by the Cloudflare HYPERDRIVE binding in wrangler.jsonc.
# Do not add a raw database URI to the application environment.
# Migration connection is intentionally not configured yet. Do not use the runtime role for DDL.
# MIGRATION_DATABASE_URL=

# Authentication
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email verification (required in production)
RESEND_API_KEY=
# Optional fallback: used only when Resend reports quota/rate-limit exhaustion.
BREVO_API_KEY=
EMAIL_FROM=EXGARASI <noreply@your-verified-domain.com>

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=exgarasi-media
R2_PUBLIC_BASE_URL=

# Payment provider
PAYMENT_PROVIDER=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# Shipping
SHIPPING_PROVIDER=
SHIPPING_API_KEY=

# Observability
SENTRY_DSN=
